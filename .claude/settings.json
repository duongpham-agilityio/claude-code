{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.*.local)",
      "Write(**/.env.development)",
      "Write(**/.env.production)",
      "Write(**/.env.staging)",
      "Write(**/.env.test)",
      "NotebookEdit(**/.env)",
      "NotebookEdit(**/.env.local)",
      "NotebookEdit(**/.env.*.local)",
      "NotebookEdit(**/.env.development)",
      "NotebookEdit(**/.env.production)",
      "NotebookEdit(**/.env.staging)",
      "NotebookEdit(**/.env.test)",
      "Bash(*.env)",
      "Bash(*.env *)",
      "Bash(*.env.local*)",
      "Bash(*.env.*.local*)",
      "Bash(*.env.development*)",
      "Bash(*.env.production*)",
      "Bash(*.env.staging*)",
      "Bash(*.env.test*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-forbidden-command.mjs\""
          }
        ]
      }
    ]
  }
}
